#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["pyyaml>=6"]
# ///
"""Repo self-checks. Exit 1 on the first class of failure found; CI runs the same.

- banned characters: em dash and emoji in tracked text files (house rule)
- posts: frontmatter shape, date matches filename
- intent: every intent/<slug>/ has intent.md; a plan.md has a checklist; a spec.md lists concerns
- ledgers: state/ledger.jsonl and state/ticks.jsonl parse line by line
- changes: state/changes.yaml parses and each change has a slug and an outcome
- size: CLAUDE.md and AGENTS.md under 120 lines (the playbook says under a page)
"""
import json, re, subprocess, sys
from pathlib import Path
import yaml

ROOT = Path(__file__).resolve().parent.parent
fails = []
def fail(msg): fails.append(msg)

tracked = subprocess.run(["git", "-C", str(ROOT), "ls-files"], capture_output=True, text=True).stdout.split()
texty = [p for p in tracked if p.endswith((".md", ".py", ".yml", ".yaml", ".toml", ".txt", ".html", ".css", ".js", ".sh")) or "/bin/" in f"/{p}"]
emoji = re.compile(r"[\U0001F300-\U0001FAFF☀-➿]")
for p in texty:
    try: txt = (ROOT / p).read_text()
    except (UnicodeDecodeError, FileNotFoundError): continue
    for i, line in enumerate(txt.splitlines(), 1):
        if "—" in line: fail(f"{p}:{i}: em dash")
        if emoji.search(line): fail(f"{p}:{i}: emoji")

fm = re.compile(r"\A---\n(.*?)\n---\n", re.S)
for p in sorted((ROOT / "posts").glob("*.md")):
    if p.name == "README.md": continue
    m = fm.match(p.read_text())
    if not m: fail(f"{p.relative_to(ROOT)}: no frontmatter"); continue
    meta = yaml.safe_load(m.group(1)) or {}
    for k in ("title", "date", "day"):
        if k not in meta: fail(f"{p.relative_to(ROOT)}: frontmatter lacks {k}")
    if str(meta.get("date")) != p.stem: fail(f"{p.relative_to(ROOT)}: date does not match filename")

for d in sorted((ROOT / "intent").iterdir()) if (ROOT / "intent").exists() else []:
    if not d.is_dir() or d.name in ("research", "candidates"): continue
    if not (d / "intent.md").exists(): fail(f"intent/{d.name}: no intent.md")
    plan = d / "plan.md"
    if plan.exists() and not re.search(r"^- \[[ x]\] ", plan.read_text(), re.M): fail(f"intent/{d.name}/plan.md: no checklist items")
    spec = d / "spec.md"
    if spec.exists() and "## Concerns" not in spec.read_text(): fail(f"intent/{d.name}/spec.md: no '## Concerns' section")

for name in ("ledger.jsonl", "ticks.jsonl", "mistakes.jsonl"):
    p = ROOT / "state" / name
    if not p.exists(): continue
    for i, line in enumerate(p.read_text().splitlines(), 1):
        if not line.strip(): continue
        try: json.loads(line)
        except ValueError: fail(f"state/{name}:{i}: not JSON")

ch = ROOT / "state" / "changes.yaml"
if ch.exists():
    try:
        data = yaml.safe_load(ch.read_text()) or {}
        for c in data.get("changes", []):
            if not c.get("slug") or not c.get("outcome"): fail(f"state/changes.yaml: change without slug or outcome: {c}")
    except yaml.YAMLError as e: fail(f"state/changes.yaml: {e}")

for name in ("CLAUDE.md", "AGENTS.md"):
    n = len((ROOT / name).read_text().splitlines())
    if n > 120: fail(f"{name}: {n} lines, keep it under a page (120)")

if fails:
    print("\n".join(fails)); sys.exit(1)
print(f"lint ok ({len(texty)} text files)")
