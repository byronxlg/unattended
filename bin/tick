#!/bin/bash
# The outer loop. launchd runs this every 600 s; it is deterministic bash and invokes the
# supervisor (headless Claude Code) only when there is something for it to judge:
#   job_done   a Codex job finished and has not been reviewed (no state/jobs/<id>/reviewed)
#   post_due   no posts/<today NZ>.md yet and it is 19:00 NZ or later
#   issue      a new comment or issue on github.com/byronxlg/unattended (Byron's channel)
#   idle       nothing running, backoff elapsed (state/next-run-after), >= 60 min since the last run
#   heartbeat  the supervisor has not run for 3 h whatever the other reasons say
# It skips when a supervisor is already running (pid file) or when a Claude usage limit was hit
# in the last 60 min (state/model.limited). Codex jobs run detached (bin/codex-run --background),
# so a running job never blocks the tick; the next tick after it finishes carries the job_done.
#
# Usage: bin/tick [--force] [--dry]      Env: SUP_TIMEOUT (s, 2700), SUP_BUDGET_USD (8)
# Evidence: state/ticks.jsonl, ~/Library/Logs/unattended-tick.log
set -u
PATH="/Users/byron/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
# run from a private copy so an in-place edit (git pull) cannot garble a running tick
if [ -z "${TICK_SELF:-}" ]; then
  _copy=$(mktemp "${TMPDIR:-/tmp}/utick.XXXXXX") && cat "$0" > "$_copy" && TICK_SELF="$0" exec bash "$_copy" "$@"
fi
ROOT="/Users/byron/repos/unattended"; cd "$ROOT" || exit 1
STATE="$ROOT/state"; mkdir -p "$STATE/jobs"
PIDF="$STATE/supervisor.pid"; TICKS="$STATE/ticks.jsonl"
SUP_TIMEOUT="${SUP_TIMEOUT:-2700}"; SUP_BUDGET_USD="${SUP_BUDGET_USD:-5}"
FORCE=0; DRY=0; for a in "$@"; do case "$a" in --force) FORCE=1;; --dry) DRY=1;; esac; done
ts() { date -u +%Y-%m-%dT%H:%M:%SZ; }
log() { echo "$(ts) $*"; }
NZ_DATE=$(TZ=Pacific/Auckland date +%F); NZ_HOUR=$(TZ=Pacific/Auckland date +%H)
TODAY_SHORT=$(TZ=Pacific/Auckland date +%Y%m%d)

# 1. a supervisor already running?
if [ -f "$PIDF" ] && kill -0 "$(cut -d' ' -f1 "$PIDF")" 2>/dev/null; then
  log "supervisor running (pid $(cut -d' ' -f1 "$PIDF")), skip"; exit 0
fi
rm -f "$PIDF"

# 2. reasons
REASONS=()
RUNNING_JOBS=$(ls "$STATE"/jobs/*/running 2>/dev/null | wc -l | tr -d ' ')
for d in "$STATE"/jobs/*/; do
  [ -d "$d" ] || continue
  [ -f "$d/running" ] && continue
  [ -f "$d/reviewed" ] && continue
  [ -f "$d/prompt.md" ] || continue
  # a job that ended (ledger line or killed) and nobody has reviewed
  if ls "$d"/last.md "$d"/events.jsonl >/dev/null 2>&1; then REASONS+=("job_done:$(basename "$d")"); fi
done
[ ! -f "posts/$NZ_DATE.md" ] && [ "$NZ_HOUR" -ge 19 ] && REASONS+=("post_due:$NZ_DATE")
# Byron's channel: issues and comments newer than the last seen timestamp
SEEN=$(cat "$STATE/issues.seen" 2>/dev/null || echo "1970-01-01T00:00:00Z")
LATEST=$(gh api "repos/byronxlg/unattended/issues?state=all&sort=updated&direction=desc&per_page=5" --jq '[.[] | select(.pull_request == null) | .updated_at] | max // empty' 2>/dev/null)
[ -n "$LATEST" ] && [[ "$LATEST" > "$SEEN" ]] && REASONS+=("issue:$LATEST")
# Watchdog: GitHub's hourly cron drifted for hours three times on 2026-10-17. When no hourly run
# is queued or running and the newest run (any conclusion) started over 90 min ago, dispatch one
# by hand. Age of the newest attempt, not the newest success, so a failing hourly is not redispatched
# every tick; the supervisor handles failures. Nothing here stops the tick.
# The dailies get the same check at 26 h (cron plus two hours of drift); the social daily's credit
# ledger stops a second run on the same budget day, so a late dispatch cannot overspend.
watchdog() { # workflow file, max age in seconds
  local age
  age=$(gh run list --workflow "$1" --limit 6 --json status,createdAt --jq 'if any(.[]; .status != "completed") then -1 else ([.[] | now - (.createdAt | fromdateiso8601)] | min // 999999 | floor) end' 2>/dev/null || echo "")
  if [ -n "$age" ] && [ "$age" -ge "$2" ] 2>/dev/null; then
    if gh workflow run "$1" --ref main >/dev/null 2>&1; then log "watchdog: newest $1 run ${age}s old, dispatched by hand"; else log "watchdog: $1 dispatch failed"; fi
  fi
}
watchdog nz-election-hourly.yml 5400
for wf in nz-election-daily.yml nz-election-social-daily.yml; do watchdog "$wf" 93600; done
LAST_RUN=$(stat -f %m "$STATE/supervisor.last" 2>/dev/null || echo 0); NOW=$(date +%s)
NEXT_AFTER=$(cat "$STATE/next-run-after" 2>/dev/null || echo 0)
if [ "$RUNNING_JOBS" = "0" ] && [ $((NOW-LAST_RUN)) -ge 3600 ] && [ "$NOW" -ge "${NEXT_AFTER:-0}" ]; then REASONS+=("idle"); fi
[ $((NOW-LAST_RUN)) -ge 10800 ] && REASONS+=("heartbeat")
[ $FORCE -eq 1 ] && REASONS+=("force")

SUP_RAN=0; SUP_RC=""; SUP_ERR=""
if [ ${#REASONS[@]} -eq 0 ]; then
  log "nothing to do (jobs running: $RUNNING_JOBS)"
elif [ $DRY -eq 1 ]; then
  log "dry: would run supervisor for ${REASONS[*]}"
else
  # Model fallback (issue #43): the first model without a limit marker under 60 min old runs.
  SUP_MODEL=""
  for m in default opus sonnet; do
    mk="$STATE/model.limited"; [ "$m" != default ] && mk="$STATE/model.limited.$m"
    if [ -z "$(find "$mk" -mmin -60 2>/dev/null)" ]; then SUP_MODEL="$m"; break; fi
  done
fi
if [ ${#REASONS[@]} -eq 0 ] || [ $DRY -eq 1 ]; then :
elif [ -z "$SUP_MODEL" ]; then
  SUP_ERR="skipped: usage limit markers under 60 min old on every model"; log "$SUP_ERR (${REASONS[*]})"
else
  SUP_RAN=1; touch "$STATE/supervisor.last"
  LEDGER_TAIL=$(tail -5 "$STATE/ledger.jsonl" 2>/dev/null | cut -c1-600)
  # Codex window: used percent from the last job that reported it, the reset time, and the
  # share of the window the lab may spend today if the rest is spread evenly to the reset.
  CODEX_WINDOW=$(python3 - "$STATE/ledger.jsonl" <<'PY'
import json, sys, time
used = reset = None
for line in open(sys.argv[1]):
    try: r = json.loads(line)
    except ValueError: continue
    rl = (r.get('rate_limits') or {}).get('primary')
    if rl: used, reset = rl.get('used_percent'), rl.get('resets_at')
if used is None: print('unknown'); sys.exit()
days = max((reset - time.time()) / 86400, 0.5) if reset else 7
print(f'used {used}% of the weekly window; resets in {days:.1f} days; even spread allows about {(100 - used) / days:.0f} points per day; stop dispatching build jobs at 90')
PY
)
  ISSUES=$(gh issue list -R byronxlg/unattended --state open --json number,title,updatedAt,author --jq '.[] | "#\(.number) \(.updatedAt) \(.author.login): \(.title)"' 2>/dev/null | head -20)
  CONTEXT="$(cat prompts/supervisor.md)

---
## This run
time_utc: $(ts)  (NZ: $(TZ=Pacific/Auckland date '+%F %H:%M'))
reasons: ${REASONS[*]}
codex_jobs_running: $RUNNING_JOBS
codex_window: $CODEX_WINDOW
disk_free_gib: $(df -k /System/Volumes/Data | awk 'NR==2{printf "%.1f",$4/1048576}')
phase:
$(cat state/phase.md 2>/dev/null || echo none)
open_issues:
${ISSUES:-none}
ledger_tail:
${LEDGER_TAIL:-none}
git_log:
$(git log --oneline -8)"
  OUT="$STATE/supervisor.out"; ERR="$STATE/supervisor.err"; : > "$OUT"
  TOOLS=("Bash(bin/*:*)" "Bash(git:*)" "Bash(gh:*)" "Bash(uv:*)" "Bash(python3:*)" "Bash(rg:*)" "Bash(fd:*)" \
         "Bash(ls:*)" "Bash(cat:*)" "Bash(head:*)" "Bash(tail:*)" "Bash(wc:*)" "Bash(jq:*)" "Bash(df:*)" "Bash(date:*)" \
         "Bash(mkdir:*)" "Bash(cp:*)" "Bash(mv:*)" "Bash(touch:*)" "Bash(diff:*)" "Bash(sed -n:*)" "Bash(sort:*)" "Bash(uniq:*)" \
         "Bash(curl -s:*)" "Bash(codex login status)" "Bash(/Users/byron/repos/management/bin/tg:*)" \
         "Read" "Write" "Edit" "Glob" "Grep" "Agent" "WebFetch" "WebSearch" "Skill")
  MODEL_ARGS=(); [ "$SUP_MODEL" != default ] && MODEL_ARGS=(--model "$SUP_MODEL")
  # bash 3.2 under set -u: an empty array needs the +-guard or the expansion aborts the subshell (05:50Z-23:30Z 2026-10-19,
  # 104 supervisor runs dead before claude started). The subshell's own stderr goes to ERR so such a failure is recorded.
  ( exec claude -p "$CONTEXT" ${MODEL_ARGS[@]+"${MODEL_ARGS[@]}"} --output-format stream-json --verbose --max-budget-usd "$SUP_BUDGET_USD" \
      --allowedTools "${TOOLS[@]}" > "$OUT" ) 2> "$ERR" &
  CPID=$!; echo "$CPID $(ts)" > "$PIDF"
  waited=0
  while kill -0 "$CPID" 2>/dev/null; do
    sleep 5; waited=$((waited+5))
    if [ "$waited" -ge "$SUP_TIMEOUT" ]; then kill "$CPID" 2>/dev/null; sleep 2; kill -9 "$CPID" 2>/dev/null; SUP_ERR="killed after ${SUP_TIMEOUT}s"; break; fi
  done
  wait "$CPID" 2>/dev/null; SUP_RC=$?; rm -f "$PIDF"
  # Only a failed run can have hit the limit; a summary that merely mentions rate limits (the ledger field) must not back the loop off.
  if [ "$SUP_RC" != "0" ] && grep -qiE "usage limit|rate limit|session limit|limit reached|reached your .{0,40}limit|out of extra usage|\b429\b" "$OUT" "$ERR" 2>/dev/null; then
    mk="$STATE/model.limited"; [ "$SUP_MODEL" != default ] && mk="$STATE/model.limited.$SUP_MODEL"
    touch "$mk"; SUP_ERR="${SUP_ERR:+$SUP_ERR; }usage limit seen on $SUP_MODEL, backing off that model 60 min"
  fi
  if [ "$SUP_RC" != "0" ] && [ -z "$SUP_ERR" ] && ! grep -q '"type":"result"' "$OUT" 2>/dev/null; then
    SUP_ERR="rc $SUP_RC, no result: $(tail -c 300 "$ERR" 2>/dev/null | tr '\n' ' ')"
  fi
  [ -n "$LATEST" ] && echo "$LATEST" > "$STATE/issues.seen"
fi

# 3. record
TICK_TS="$(ts)" REASONS_STR="${REASONS[*]:-}" RUNNING_JOBS="$RUNNING_JOBS" SUP_RAN="$SUP_RAN" SUP_RC="$SUP_RC" SUP_ERR="$SUP_ERR" \
OUT="${OUT:-}" TICKS="$TICKS" python3 - <<'PY'
import json, os
e = os.environ
rec = {"ts": e["TICK_TS"], "reasons": e["REASONS_STR"].split() if e["REASONS_STR"] else [], "jobs_running": int(e["RUNNING_JOBS"]),
       "supervisor": {"ran": e["SUP_RAN"] == "1", "rc": e["SUP_RC"] or None, "error": e["SUP_ERR"] or None,
                      "cost_usd": None, "turns": None, "duration_ms": None, "result": None}}
if rec["supervisor"]["ran"] and e["OUT"] and os.path.exists(e["OUT"]):
    last = None
    for line in open(e["OUT"], errors="replace"):
        try: o = json.loads(line)
        except ValueError: continue
        if isinstance(o, dict) and o.get("type") == "result": last = o
    if last:
        rec["supervisor"].update({"cost_usd": last.get("total_cost_usd"), "turns": last.get("num_turns"),
                                  "duration_ms": last.get("duration_ms"), "result": " ".join(str(last.get("result", "")).split())[:500]})
with open(e["TICKS"], "a") as f: f.write(json.dumps(rec) + "\n")
print(json.dumps(rec)[:400])
PY
